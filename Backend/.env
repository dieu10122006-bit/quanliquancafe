# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_management_system

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:8000

# Email Configuration
# Development: Sẽ dùng Ethereal Email (test email miễn phí)
# Production: Cầu hình SMTP server của bạn
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
SMTP_FROM=noreply@cafehdtq.com
SMTP_SECURE=false

# OTP Configuration
OTP_EXPIRY=300000
OTP_MAX_ATTEMPTS=3
