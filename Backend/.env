PORT=5000                      # Port server
NODE_ENV=development           # Môi trường dev

DB_HOST=localhost              # Host DB
DB_PORT=3306                   # Port DB
DB_USER=root                   # User DB
DB_PASSWORD=                   # Password DB
DB_NAME=cafe_management_system# Tên DB

JWT_SECRET=your_secret         # Khóa JWT
JWT_EXPIRE=7d                  # Hết hạn token

CORS_ORIGIN=http://localhost:8000 # Frontend URL

SMTP_HOST=smtp.example.com     # Server email
SMTP_PORT=2525                 # Port email
SMTP_USER=user                 # User email
SMTP_PASS=pass                 # Password email

OTP_EXPIRY=300000              # Hết hạn OTP